# decision for the fork, not a defect; accept the tag rather than invent stubs.
# Affected paths: usr/bin/unitc, usr/bin/setup-unit,
#                 usr/sbin/%%RUNTIME%%d, usr/sbin/%%RUNTIME%%d-debug
%%PACKAGE%%: no-manual-page
