{
	"applications": {
		"example_php": {
			"type": "php",
			"processes": 2,
			"root": "/usr/share/doc/%%PACKAGE%%/examples/php-app",
			"index": "index.php"
		},

		"example_python": {
			"type": "python",
			"processes": 2,
			"path": "/usr/share/doc/%%PACKAGE%%/examples/python-app",
			"module": "wsgi"
		},

		"example_go": {
			"type": "external",
			"executable": "/usr/local/bin/%%PACKAGE%%-go-app"
		},

		"example_perl": {
			"type": "perl",
			"processes": 1,
			"working_directory": "/usr/share/doc/%%PACKAGE%%-perl/examples/perl-app",
			"script": "/usr/share/doc/%%PACKAGE%%-perl/examples/perl-app/index.pl"
		}
	},

	"listeners": {
		"127.0.0.1:8300": {
			"pass": "applications/example_php"
		},

		"127.0.0.1:8400": {
			"pass": "applications/example_python"
		},

		"127.0.0.1:8500": {
			"pass": "applications/example_go"
		},

		"127.0.0.1:8600": {
			"pass": "applications/example_perl"
		}
	}
}
